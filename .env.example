# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/civic_ai

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# LLM provider: local | groq
LLM_PROVIDER=local
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings / reranker
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_DIM=1024

# Auth
JWT_SECRET=change-me-in-production

# Optional
OPENAI_API_KEY=

# Frontend → API (browser). Loaded from repo-root .env only.
NEXT_PUBLIC_API_URL=https://civicai-api.visio.md
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# API bind
API_HOST=0.0.0.0
API_PORT=8000

# HuggingFace cache (optional, Windows example: D:\hf-cache)
HF_HOME=
TRANSFORMERS_CACHE=
